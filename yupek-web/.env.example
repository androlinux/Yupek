# Public Supabase credentials (PUBLIC - safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://umopnncjoswyilibslep.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xGCmb036JS-dQiAi0KxWVw_LKUjQyfB

# Supabase Service Role Key (SERVER-ONLY / SECRET - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Public site domain (PUBLIC)
# Development: http://localhost:3000
# Production:  https://www.yupek.shop
NEXT_PUBLIC_SITE_URL=https://www.yupek.shop
PUBLIC_SITE_URL=https://www.yupek.shop

# Backend API Base URL
# Development: http://127.0.0.1:8000
# Production:  https://<YOUR_DEPLOYED_BACKEND_DOMAIN>
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=

# Printify Server-Side Credentials (SERVER-ONLY / SECRET - NEVER prefix with NEXT_PUBLIC_)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=29215191
PRINTIFY_BASE_URL=https://api.printify.com/v1
PRINTIFY_WEBHOOK_SECRET=

# SMTP Email Configuration (SERVER-ONLY / SECRET)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@yupek.shop

# Admin Authorization Key (SERVER-ONLY / SECRET - NEVER expose to browser)
YUPEK_ADMIN_KEY=

# Stripe Payment Pipeline (SERVER-ONLY / SECRET for keys & webhooks; PUBLIC for publishable key)
# IMPORTANT: Stripe TEST MODE keys only (pk_test_... and sk_test_...). Never use live keys without authorization.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
