# Public Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://umopnncjoswyilibslep.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xGCmb036JS-dQiAi0KxWVw_LKUjQyfB

# Public site domain
# Development: http://localhost:3000
# Production:  https://www.yupek.shop
NEXT_PUBLIC_SITE_URL=https://www.yupek.shop

# Backend API Base URL
# Development: http://127.0.0.1:8000
# Production:  https://<YOUR_DEPLOYED_BACKEND_DOMAIN>
# (Alternatively configure server-only BACKEND_URL)
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=

# Printify Server-Side Credentials (Server-only, NEVER prefix with NEXT_PUBLIC_)
# Required for webhooks, product sync, and resilient API fallback
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=29215191
PRINTIFY_WEBHOOK_SECRET=

# Contact & Order Notification Email (Optional)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATION_GMAIL=

# Stripe Payment Pipeline (Server-only for secrets, never prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
