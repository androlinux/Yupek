# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for old HS256 projects. Leave empty for new projects (JWKS is used).
SUPABASE_JWT_SECRET=

# Frontend origins allowed by CORS, comma separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.yupek.shop,https://yupek.shop

# Stripe (leave empty = checkout returns "Payments not configured")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects /api/cron/* endpoints (send as header X-Cron-Secret)
CRON_SECRET=change-me

# Pricing
VAT_RATE=0.21
SUPPLIER_MARKUP=2.2

# Printify
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=29215191
PRINTIFY_BASE_URL=https://api.printify.com/v1
PRINTIFY_WEBHOOK_SECRET=

# Promio (Print-on-demand supplier)
PROMIO_APP_ID=
PROMIO_SECRET_KEY=
PROMIO_BASE_URL=https://promio.pro/api
PROMIO_ENABLED=false
PROMIO_CATALOG_SYNC_ENABLED=false
