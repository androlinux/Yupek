# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for old HS256 projects. Leave empty for new projects (JWKS is used).
SUPABASE_JWT_SECRET=

# Frontend origins allowed by CORS, comma separated
CORS_ORIGINS=http://localhost:3000

# Stripe (leave empty = checkout returns "Payments not configured")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects /api/cron/* endpoints (send as header X-Cron-Secret)
CRON_SECRET=change-me

# Pricing
VAT_RATE=0.21
SUPPLIER_MARKUP=2.2
